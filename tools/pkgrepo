#!/usr/bin/env python3
"""The package repository's bookkeeping: what to build, and moving source pins.

  pkgrepo check                       every recipe agrees with its source pin
  pkgrepo plan [--package NAME]       which packages the published repositories lack (JSON for CI)
  pkgrepo record [--base B] STATE NAME...
                                      note the recipes the named packages were built from in STATE
  pkgrepo bump [--repository R] [--package NAME] [--tag TAG]
                                      move pins to their source's newest release
  pkgrepo rebuild [--published-only] NAME...
                                      raise pkgrel: same source, built again
  pkgrepo prune [--base B] --index DB... --assets FILE...
                                      which published package files no given index names any more
  pkgrepo files --base B INDEX        the package files an index names, one per line
  pkgrepo orchard-release VERSION     the kernel packages to orchard's release VERSION (pkgver, checksums)

Standard library only. Recipes are per base: packages/NAME/arch/PKGBUILD
(Arch Linux ARM, pacman) and packages/NAME/alpine/APKBUILD (Alpine, apk). They
state pkgname, pkgver, pkgrel (and epoch) and arch as plain assignments; they
are read here without a shell.

Packages publish for releases of their sources only: `bump` follows release
tags. orchard's kernel packages (linux-orchard-PLATFORM) repack an orchard
release's platform layer; `orchard-release` is their bump. pkgrepo only edits
recipes: makepkg and abuild build them without it.
"""
import argparse
import gzip
import hashlib
import io
import json
import os
from pathlib import Path
import re
import sys
import tarfile
from urllib.error import HTTPError
from urllib.request import Request, urlopen

ROOT = Path(__file__).resolve().parents[1]
PACKAGES = ROOT / 'packages'
# Each base: its recipe in a package's directory and the architectures it publishes.
BASES = {'arch': {'recipe': 'arch/PKGBUILD', 'arches': ('aarch64', 'armv7h')},
         'alpine': {'recipe': 'alpine/APKBUILD', 'arches': ('aarch64', 'armv7')}}
ARCHES = BASES['arch']['arches']
REPOSITORY = os.environ.get('GITHUB_REPOSITORY', 'OrchardLinux/packages')
# Packages whose compile is long enough for a compiler cache to pay.
CCACHE = {'mesa'}
ORCHARD = 'OrchardLinux/orchard'


def tag(arch, base='arch'):
    """The release that holds one repository. apk asks for SERVER/ARCH/APKINDEX.tar.gz, so an
    apk repository is the release named after its architecture, below .../releases/download."""
    return f'repo-{arch}' if base == 'arch' else arch


def server(arch, base='arch'):
    return f'https://github.com/{REPOSITORY}/releases/download/{tag(arch, base)}'


def fail(message):
    sys.exit('pkgrepo: ' + message)


def names(base=None):
    """Packages with a recipe for BASE (any base by default)."""
    recipes = [BASES[base]['recipe']] if base else [row['recipe'] for row in BASES.values()]
    return sorted({p.parents[1].name for pattern in recipes for p in PACKAGES.glob('*/' + pattern)})


def bases(name):
    return [base for base, row in BASES.items() if (PACKAGES / name / row['recipe']).is_file()]


def recipe(name, base='arch'):
    path = PACKAGES / name / BASES[base]['recipe']
    if not path.is_file():
        fail(f'no {base} recipe for {name}')
    text = path.read_text()
    fields = {}
    for key in ('pkgname', 'epoch', 'pkgver', 'pkgrel'):
        found = re.findall(rf"^{key}=(['\"]?)([A-Za-z0-9._+-]+)\1$", text, re.M)
        if len(found) > 1 or (not found and key != 'epoch'):
            fail(f'{name}: {key} must be one plain assignment')
        fields[key] = found[0][1] if found else None
    if fields['pkgname'] != name:
        fail(f'{name}: pkgname is {fields["pkgname"]}')
    arch = re.findall(r'^arch=\(([^)]*)\)$' if base == 'arch' else r'^arch="([^"]*)"$', text, re.M)
    if len(arch) != 1:
        fail(f'{name}: arch must be one plain assignment')
    fields['arch'] = [a for a in re.findall(r'[a-z0-9_]+', arch[0]) if a in BASES[base]['arches']]
    epoch = fields['epoch'] + ':' if fields['epoch'] else ''
    if base == 'alpine':
        if epoch:
            fail(f'{name}: an APKBUILD has no epoch')
        fields['version'] = f'{fields["pkgver"]}-r{fields["pkgrel"]}'
    else:
        fields['version'] = f'{epoch}{fields["pkgver"]}-{fields["pkgrel"]}'
    fields['text'] = text
    fields['path'] = path
    return fields


def recipe_digest(name, base='arch'):
    """One digest over everything a base's package is built from: pin, patches, its recipe."""
    digest = hashlib.sha256()
    directory = PACKAGES / name
    # Not tests/ (a test that changes does not change the package), nor another base's recipe.
    skip = {'tests'} | {other for other in BASES if other != base}
    for path in sorted(p for p in directory.rglob('*') if p.is_file() and p.relative_to(directory).parts[0] not in skip):
        relative = path.relative_to(directory).as_posix()
        # The Arch recipes lived in pacman/ when the published digests were recorded.
        relative = 'pacman/' + relative.removeprefix('arch/') if relative.startswith('arch/') else relative
        digest.update(relative.encode() + b'\0' +
                      hashlib.sha256(path.read_bytes()).hexdigest().encode() + b'\n')
    return digest.hexdigest()


def pin(name):
    return json.loads((PACKAGES / name / 'source.json').read_text())


def check(_args=None):
    for name in names():
        source = pin(name)
        if 'file' in source:
            path = PACKAGES / name / source['file']
            if hashlib.sha256(path.read_bytes()).hexdigest() != source['sha256']:
                fail(f'{name}: {source["file"]} differs from its pin')
        for base in bases(name):
            built = recipe(name, base)
            # pacman checks sha256, apk sha512: each recipe names the checksum its base uses.
            for key in (('sha256', 'commit') if base == 'arch' else ('sha512', 'commit')):
                if key in source and source[key] not in built['text']:
                    fail(f'{name}: the {base} recipe does not name the pinned {key} {source[key]}')
            if 'tag' in source and built['pkgver'] != release_pkgver(source['tag']):
                fail(f'{name}: pkgver {built["pkgver"]} is not the pinned release\'s {release_pkgver(source["tag"])}')
            elif 'tag' not in source and 'revision' in source and built['pkgver'] != tracked_pkgver(source):
                fail(f'{name}: pkgver {built["pkgver"]} is not the pinned commit\'s {tracked_pkgver(source)}')
            if 'orchard' in source and built['pkgver'] != source['orchard']:
                fail(f'{name}: the {base} recipe is not orchard {source["orchard"]}')
            if not built['arch']:
                fail(f'{name}: the {base} recipe builds for none of {", ".join(BASES[base]["arches"])}')
    print('Recipes agree with their pins:', ', '.join(names()))


def fetch(url, *, token=True, binary=True, headers=False):
    request = Request(url, headers={'User-Agent': 'orchard-packages'})
    key = os.environ.get('GH_TOKEN') or os.environ.get('GITHUB_TOKEN')
    if token and key and url.startswith('https://api.github.com/'):
        request.add_header('Authorization', 'Bearer ' + key)
    with urlopen(request, timeout=120) as response:
        data = response.read()
        if headers:
            return data, response.headers
        return data if binary else data.decode()


def entries(data, base='arch'):
    """An index's packages: {name: (version, file name)}. pacman's orchard.db, or apk's APKINDEX.tar.gz."""
    found = {}
    if base == 'alpine':
        # A signed APKINDEX is the signature's tar, then the index's, one gzip stream each.
        with tarfile.open(fileobj=io.BytesIO(gzip.decompress(data)), ignore_zeros=True) as archive:
            for member in archive:
                if member.name == 'APKINDEX':
                    for block in archive.extractfile(member).read().decode().split('\n\n'):
                        fields = dict(line.split(':', 1) for line in block.splitlines() if ':' in line)
                        if 'P' in fields and 'V' in fields:
                            found[fields['P']] = (fields['V'], f'{fields["P"]}-{fields["V"]}.apk')
        return found
    with tarfile.open(fileobj=io.BytesIO(data)) as archive:
        for member in archive:
            if member.name.endswith('/desc'):
                lines = archive.extractfile(member).read().decode().split('\n')
                value = lambda key: lines[lines.index(key) + 1]
                found[value('%NAME%')] = (value('%VERSION%'), value('%FILENAME%'))
    return found


INDEX = {'arch': 'orchard.db', 'alpine': 'APKINDEX.tar.gz'}


def published(arch, base='arch'):
    """The published index of one base and architecture: {package name: version}."""
    try:
        data = fetch(server(arch, base) + '/' + INDEX[base])
    except HTTPError as error:
        if error.code == 404:
            return {}
        raise
    return {name: version for name, (version, _) in entries(data, base).items()}


def state(arch, base='arch'):
    """What the publish job recorded: {package name: {version, recipe}}."""
    try:
        return json.loads(fetch(server(arch, base) + '/built.json'))
    except HTTPError as error:
        if error.code == 404:
            return {}
        raise


def plan(args):
    check()
    builds, changed = [], []
    for base, row in BASES.items():
        for arch in row['arches']:
            wanted = [name for name in names(base) if not args.package or name == args.package]
            wanted = [name for name in wanted if arch in recipe(name, base)['arch'] and not waiting(name)]
            if not wanted:
                continue
            index, recorded = published(arch, base), state(arch, base)
            for name in wanted:
                built = recipe(name, base)
                where = f'{base}/{arch}'
                if index.get(name) != built['version']:
                    builds.append({'package': name, 'base': base, 'arch': arch, 'version': built['version'],
                                   'ccache': name in CCACHE})
                    print(f'build   {where:15} {name} {built["version"]} (published: {index.get(name, "nothing")})',
                          file=sys.stderr)
                elif recorded.get(name, {}).get('recipe') not in (None, recipe_digest(name, base)):
                    changed.append(f'{name} ({where})')
                else:
                    print(f'current {where:15} {name} {built["version"]}', file=sys.stderr)
    if changed:
        fail('recipe, patches or pin changed but the version is already published: ' + ', '.join(changed) +
             '. Raise pkgrel (tools/pkgrepo rebuild NAME).')
    targets = sorted({(b['base'], b['arch']) for b in builds})
    result = {'matrix': json.dumps({'include': builds}), 'any': 'true' if builds else 'false',
              'targets': json.dumps([{'base': base, 'arch': arch} for base, arch in targets])}
    lines = ''.join(f'{key}={value}\n' for key, value in result.items())
    output = os.environ.get('GITHUB_OUTPUT')
    if output:
        with open(output, 'a') as stream:
            stream.write(lines)
    else:
        sys.stdout.write(lines)


def waiting(name):
    """A package that follows its source's releases and has none pinned yet (omarchy-a before its first)."""
    source = pin(name)
    return source.get('track') == 'releases' and 'tag' not in source


def record(args):
    """After packages of ARCH were added to the index: note their recipes."""
    path = Path(args.state)
    recorded = json.loads(path.read_text()) if path.is_file() else {}
    for name in args.names:
        recorded[name] = {'version': recipe(name, args.base)['version'], 'recipe': recipe_digest(name, args.base)}
    path.write_text(json.dumps(recorded, indent=2, sort_keys=True) + '\n')


def tracked_pkgver(source):
    """Mesa's 27.0.0-devel at commit number 232935 is 27.0.0.dev.232935.g2c1aa767d8d.

    The commit's number on its branch makes a newer commit a newer package.
    It is a plain number, not r232935: pacman reads a version that goes on
    with a letter as older than the version that stops there, and a tablet
    with omactivity 0.1.0 has to take 0.1.0.14.g3ffeac29dea as an update.
    """
    version = source['version'].replace('-devel', '.dev').replace('-', '.')
    return f'{version}.{source["revision"]}.g{source["commit"][:11]}'


def api(path):
    return json.loads(fetch('https://api.github.com/' + path))


def release_pkgver(tag):
    """The package version of a release tag: v0.1.1 is 0.1.1."""
    return tag.removeprefix('v')


def vercmp(left, right):
    """pacman's version order, for the versions found here: < 0, 0 or > 0."""
    a, b = re.findall(r'[0-9]+|[A-Za-z]+', left), re.findall(r'[0-9]+|[A-Za-z]+', right)
    for x, y in zip(a, b):
        if x.isdigit() and y.isdigit():
            if int(x) != int(y):
                return int(x) - int(y)
        elif x.isdigit() != y.isdigit():
            return 1 if x.isdigit() else -1
        elif x != y:
            return 1 if x > y else -1
    if len(a) == len(b):
        return 0
    rest = (a if len(a) > len(b) else b)[min(len(a), len(b))]
    # A longer version that goes on with a number is newer; with letters (rc1), older.
    newer = rest.isdigit()
    return (1 if newer else -1) * (1 if len(a) > len(b) else -1)


def bump_one(name, tag=None):
    """Move a pin to its source's newest release (or TAG), if that is newer than the pinned version."""
    source = pin(name)
    repository = source['repository']
    try:
        release = api(f'repos/{repository}/releases/' + (f'tags/{tag}' if tag else 'latest'))
    except HTTPError as error:
        if error.code != 404:
            raise
        print(f'{name}: {repository} has no release{" " + tag if tag else ""}; nothing to do')
        return False
    new = release['tag_name']
    if new == source.get('tag'):
        print(f'{name}: {repository} {new} is still the newest release')
        return False
    if not re.fullmatch(r'v?[0-9]+(\.[0-9]+)*', new):
        print(f'{name}: {repository} release {new} is not a version tag (v1.2.3); nothing to do')
        return False
    if bases(name) != ['arch']:
        fail(f'{name}: bump moves Arch recipes only; move the other bases\' by hand')
    path = PACKAGES / name / BASES['arch']['recipe']
    text = path.read_text()
    current = recipe(name)['pkgver']
    if vercmp(release_pkgver(new), current) <= 0:
        print(f'{name}: {repository} {new} is not newer than the published {current}; staying')
        return False
    commit = api(f'repos/{repository}/commits/{new}')['sha']
    url = f'https://github.com/{repository}/archive/{commit}.tar.gz'
    digest = hashlib.sha256(fetch(url)).hexdigest()
    updated = {key: value for key, value in source.items() if key not in ('revision', 'rebased', 'track')}
    updated.update(track='releases', tag=new, version=release_pkgver(new), commit=commit, url=url, sha256=digest)
    for pattern, value in ((r'^_commit=.*$', '_commit=' + commit), (r'^pkgver=.*$', 'pkgver=' + release_pkgver(new)),
                           (r'^pkgrel=.*$', 'pkgrel=1')):
        text, count = re.subn(pattern, value, text, flags=re.M)
        if count != 1:
            fail(f'{name}: the recipe has no single line for {pattern}')
    if 'sha256' not in source:
        # The first release of a package that waited for one: its archive is the first source.
        text, count = re.subn(r"^sha256sums=\('[^']*'", f"sha256sums=('{digest}'", text, flags=re.M)
        if count != 1:
            fail(f'{name}: the recipe has no single first checksum to pin')
    elif text.count(source['sha256']) != 1:
        fail(f'{name}: the recipe does not name the old archive checksum once')
    else:
        text = text.replace(source['sha256'], digest)
    path.write_text(text)
    (PACKAGES / name / 'source.json').write_text(json.dumps(updated, indent=2) + '\n')
    print(f'{name}: {repository} {source.get("tag") or source.get("commit", "none")[:11]} -> {new}')
    return True


def bump(args):
    if args.tag and not args.repository and not args.package:
        fail('--tag needs --repository or --package')
    moved = []
    for name in names():
        source = pin(name)
        # "track" names the branch a pin was first taken from; pins move to releases only.
        if 'track' not in source or (args.package and name != args.package):
            continue
        if args.repository and source['repository'].lower() != args.repository.lower():
            continue
        if bump_one(name, args.tag):
            moved.append(name)
    check()
    output = os.environ.get('GITHUB_OUTPUT')
    if output:
        with open(output, 'a') as stream:
            stream.write('moved=' + ' '.join(moved) + '\n')


def rebuild(args):
    for name in args.names:
        for base in bases(name):
            built = recipe(name, base)
            if args.published_only and not any(
                    published(arch, base).get(name) == built['version'] for arch in built['arch']):
                fail(f'{name} {built["version"]} ({base}) is not published: an earlier rebuild is still '
                     'building or failed')
            parts = built['pkgrel'].split('.')
            parts[-1] = str(int(parts[-1]) + 1)
            built['path'].write_text(re.sub(r'^pkgrel=.*$', 'pkgrel=' + '.'.join(parts), built['text'], flags=re.M))
            print(f'{name} ({base}): pkgrel {built["pkgrel"]} -> {".".join(parts)}')


def prune(args):
    """Of a release's files, the packages that neither the new index nor the one before it names.

    A tablet that read the index a moment before a publish still finds its files.
    """
    keep = set()
    for path in args.index:
        if Path(path).is_file():
            keep |= {filename for _, filename in entries(Path(path).read_bytes(), args.base).values()}
    for asset in args.assets:
        package = '.pkg.tar.' in asset if args.base == 'arch' else asset.endswith('.apk')
        if package and asset.removesuffix('.sig') not in keep:
            print(asset)


def files(args):
    for _, filename in sorted(entries(Path(args.index).read_bytes(), args.base).values()):
        print(filename)


def orchard_release(args):
    """The kernel packages (source.json "orchard") to an orchard release: pkgver, pkgrel and checksums.

    A release of orchard is this one bump. Each package repacks its platform's layer, an
    asset of that release, unchanged; its sha256 comes from the release's SHA256SUMS and
    is checked against the download, which also gives apk's sha512.
    """
    version = args.version.removeprefix('v')
    if not re.fullmatch(r'[0-9]+(\.[0-9]+)*', version):
        fail(f'not an orchard release version: {args.version}')
    base_url = f'https://github.com/{ORCHARD}/releases/download/v{version}'
    sums = {}
    for line in fetch(base_url + '/SHA256SUMS', binary=False).splitlines():
        digest, _, filename = line.partition('  ')
        sums[filename.removeprefix('./')] = digest
    for name in names():
        source = pin(name)
        if 'orchard' not in source:
            continue
        asset = source['asset']
        if asset not in sums:
            fail(f'{name}: orchard v{version} has no {asset}')
        data = fetch(f'{base_url}/{asset}')
        if hashlib.sha256(data).hexdigest() != sums[asset]:
            fail(f'{name}: {asset} differs from orchard v{version}\'s SHA256SUMS')
        updated = dict(source, orchard=version, sha256=sums[asset], sha512=hashlib.sha512(data).hexdigest())
        for base in bases(name):
            built = recipe(name, base)
            text = built['text']
            key = 'sha256' if base == 'arch' else 'sha512'
            if text.count(source[key]) != 1:
                fail(f'{name}: the {base} recipe does not name the old {key} once')
            text = text.replace(source[key], updated[key])
            text = re.sub(r'^pkgver=.*$', 'pkgver=' + version, text, flags=re.M)
            text = re.sub(r'^pkgrel=.*$', 'pkgrel=' + ('1' if base == 'arch' else '0'), text, flags=re.M)
            built['path'].write_text(text)
        (PACKAGES / name / 'source.json').write_text(json.dumps(updated, indent=2) + '\n')
        print(f'{name}: orchard {source["orchard"]} -> {version}')
    check()


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('check').set_defaults(run=check)
    sub = commands.add_parser('plan')
    sub.add_argument('--package')
    sub.set_defaults(run=plan)
    sub = commands.add_parser('record')
    sub.add_argument('--base', choices=sorted(BASES), default='arch')
    sub.add_argument('state')
    sub.add_argument('names', nargs='+')
    sub.set_defaults(run=record)
    sub = commands.add_parser('bump')
    sub.add_argument('--repository')
    sub.add_argument('--tag')
    sub.add_argument('--package')
    sub.set_defaults(run=bump)
    sub = commands.add_parser('rebuild')
    sub.add_argument('--published-only', action='store_true',
                     help='refuse unless the current version is the published one')
    sub.add_argument('names', nargs='+')
    sub.set_defaults(run=rebuild)
    sub = commands.add_parser('prune')
    sub.add_argument('--base', choices=sorted(BASES), default='arch')
    sub.add_argument('--index', nargs='+', required=True)
    sub.add_argument('--assets', nargs='*', default=[])
    sub.set_defaults(run=prune)
    sub = commands.add_parser('files')
    sub.add_argument('--base', choices=sorted(BASES), default='arch')
    sub.add_argument('index')
    sub.set_defaults(run=files)
    sub = commands.add_parser('orchard-release')
    sub.add_argument('version')
    sub.set_defaults(run=orchard_release)
    args = parser.parse_args()
    args.run(args)


if __name__ == '__main__':
    main()
