# After a kernel, its initrd or device trees, the boot splash or the script
# changed: this system's boot entries follow (orchard docs/boot-contract.md).
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/initrd
Target = usr/lib/modules/*/dtb/*
Target = usr/share/orchard/splash
Target = usr/lib/orchard/boot-entries

[Action]
Description = Updating this system's boot entries...
When = PostTransaction
Exec = /bin/sh -c '[ ! -x /usr/lib/orchard/boot-entries ] || exec /usr/lib/orchard/boot-entries sync'
