+void
+overview_gesture_end_closed(void)
+{
+	if (ov.gesture.pending) {
+		overview_gesture_end();
+		return;
+	}
+	if (ov.state != TRACKING) {
+		return;
+	}
+	ov.state = OPEN;
+	finish(NULL);
+	ov.last_tick = now();
+	redraw();
+}
