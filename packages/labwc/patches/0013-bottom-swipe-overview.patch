+/*
+ * One finger up from the bottom edge, once the swipe is claimed: the
+ * overview follows it. Past half the screen the overview gives way again
+ * and letting go runs the far command (the session's launcher).
+ */
+static struct {
+	bool active;
+	int32_t touch_id;
+	double start_y;   /* where the finger began, in layout coordinates */
+	double height;    /* the output's */
+	double travel;    /* how far up it is now */
+	char *far_command;
+	char *far_socket; /* its path, or NULL */
+	int fd;           /* connected to far_socket, or -1 */
+	double sent;      /* the last progress sent, -1 before any */
+	bool fast;        /* a fast drag: nothing shows until it ends or slows */
+	double velocity;  /* upward, in px per ms, smoothed */
+	double last_travel;
+	uint32_t last_time; /* 0 before the first motion */
+} edge = { .fd = -1 };
+
+/* Here the overview is open (its own gestures take 0.3 of the height). */
+#define EDGE_OPEN 0.18
+#define EDGE_PACE (0.3 / EDGE_OPEN)
+/* Up to here it holds open; from here the far surface comes in. */
+#define EDGE_RECEDE 0.22
+/* Here the overview has gone back entirely and the far surface is in. */
+#define EDGE_GONE 0.36
+/* From here, halfway between, letting go is the far command's. */
+#define EDGE_FAR ((EDGE_RECEDE + EDGE_GONE) / 2)
+/*
+ * A drag that starts this fast (px per ms) is a fast one: the overview and
+ * the far surface stay out of it, and only where it ends counts. Slowing to
+ * half that makes it a slow one, which shows the way as it goes.
+ */
+#define EDGE_FAST 1.0
+
+/* Where a drag that ends here goes: 2 the far command, 1 the overview, 0
+ * nowhere. A fast drag needs to have gone half the overview's way. */
+static int
+edge_end_target(double travel, bool fast)
+{
+	if (travel >= edge.height * EDGE_FAR) {
+		return 2;
+	}
+	return !fast || travel >= edge.height * EDGE_OPEN / 2 ? 1 : 0;
+}
+
+static double
+edge_overview_travel(double travel)
+{
+	double recede = edge.height * EDGE_RECEDE;
+	/* With a surface following the finger (edge.fd), the overview holds
+	 * still under it rather than growing its windows back. */
+	if (travel <= recede || !edge.far_command || edge.fd >= 0) {
+		return travel * EDGE_PACE;
+	}
+	/* Going on, the overview goes back, three times as fast. */
+	return fmax(0, recede - (travel - recede) * 3) * EDGE_PACE;
+}
+
+/* How far the far command's surface is in, 0 to 1. */
+static double
+edge_far_progress(double travel)
+{
+	double from = edge.height * EDGE_RECEDE, to = edge.height * EDGE_GONE;
+	return fmin(1, fmax(0, (travel - from) / (to - from)));
+}
+
+static void
+edge_send(const char *line)
+{
+	if (edge.fd < 0 && edge.far_socket) {
+		struct sockaddr_un addr = { .sun_family = AF_UNIX };
+		const char *dir = edge.far_socket[0] == '/' ? "" : getenv("XDG_RUNTIME_DIR");
+		if (!dir || snprintf(addr.sun_path, sizeof(addr.sun_path), "%s%s%s", dir,
+				*dir ? "/" : "", edge.far_socket) >= (int)sizeof(addr.sun_path)) {
+			return;
+		}
+		int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+		if (fd < 0) {
+			return;
+		}
+		if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0 && errno != EINPROGRESS) {
+			close(fd);
+			/* Nobody listening: the far command alone, on letting go. */
+			zfree(edge.far_socket);
+			return;
+		}
+		edge.fd = fd;
+	}
+	if (edge.fd >= 0) {
+		/* A line the shell is too slow for is dropped; the next replaces it. */
+		ssize_t n = send(edge.fd, line, strlen(line), MSG_NOSIGNAL | MSG_DONTWAIT);
+		(void)n;
+	}
+}
+
+static void
+edge_follow(double travel)
+{
+	double p = edge_far_progress(travel);
+	if (edge.sent < 0 && p <= 0) {
+		return;
+	}
+	if (fabs(p - edge.sent) < 0.005) {
+		return;
+	}
+	char line[32];
+	snprintf(line, sizeof(line), "p %.3f\n", p);
+	edge_send(line);
+	edge.sent = p;
+}
+
+static void
+edge_stop(bool released)
+{
+	if (!edge.active) {
+		return;
+	}
+	edge.active = false;
+	int target = released ? edge_end_target(edge.travel, edge.fast) : 0;
+	bool far = target == 2 && edge.far_command;
+	bool followed = edge.fd >= 0 && edge.sent >= 0;
+	if (edge.sent >= 0) {
+		edge_send(far ? "end 1\n" : "end 0\n");
+	}
+	if (edge.fd >= 0) {
+		close(edge.fd);
+		edge.fd = -1;
+	}
+	if (far) {
+		if (followed) {
+			/* Under the launcher already: gone at once, no windows
+			 * growing back behind it. */
+			overview_abort();
+		} else {
+			overview_gesture_end_closed();
+		}
+		/* Opens it when nothing followed the finger; else no change. */
+		spawn_async_no_shell(edge.far_command);
+	} else if (released && edge.fast && target == 1) {
+		/* A fast drag that ended where the overview is: it opens. */
+		overview_gesture_update(edge_overview_travel(edge.height * EDGE_OPEN),
+			edge.last_time);
+		overview_gesture_end();
+	} else if (released && !edge.fast) {
+		overview_gesture_end();
+	} else {
+		overview_gesture_end_closed();
+	}
+	zfree(edge.far_command);
+	zfree(edge.far_socket);
+}
+
+static void
+edge_motion(double ly, uint32_t time_msec)
+{
+	edge.travel = edge.start_y - ly;
+	if (edge.last_time && time_msec != edge.last_time) {
+		double v = (edge.travel - edge.last_travel)
+			/ (uint32_t)(time_msec - edge.last_time);
+		edge.velocity = edge.velocity * 0.5 + v * 0.5;
+	}
+	edge.last_travel = edge.travel;
+	edge.last_time = time_msec;
+	if (edge.fast && edge.velocity < EDGE_FAST / 2) {
+		edge.fast = false;
+	}
+	if (edge.fast) {
+		return;
+	}
+	/* First the follower, which decides whether the overview goes back. */
+	if (edge.far_command) {
+		edge_follow(edge.travel);
+	}
+	overview_gesture_update(edge_overview_travel(edge.travel), time_msec);
+}
