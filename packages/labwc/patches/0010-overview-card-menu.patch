index b1dbaf8..bc46628 100644
--- a/include/overview.h
+++ b/include/overview.h
@@ -46,6 +46,8 @@ bool overview_handle_key(xkb_keysym_t sym);
  * the panel's.
  */
 bool overview_press(double lx, double ly, uint32_t time_msec);
+/* A right click: the menu of the card under it. False beside the overview. */
+bool overview_context(double lx, double ly);
 void overview_motion(double lx, double ly, uint32_t time_msec);
 void overview_release(uint32_t time_msec);
 void overview_press_cancel(void);
