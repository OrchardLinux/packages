diff --git a/include/input/osk.h b/include/input/osk.h
new file mode 100644
index 0000000..51d3410
--- /dev/null
+++ b/include/input/osk.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_OSK_H
+#define LABWC_OSK_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct seat;
+struct text_input;
+struct wlr_surface;
+
+/*
+ * Facts for an on-screen keyboard, reported to one listener program
+ * (<onScreenKeyboard listener="command" />). Labwc starts the listener
+ * once and writes one line per fact to its standard input; it decides
+ * what the keyboard does. Labwc keeps no keyboard policy of its own.
+ *
+ *   field on VERSION   the focused client enabled a text-input
+ *                      (VERSION: the client's text-input-v3 version)
+ *   field off          no focused text-input is enabled any more
+ *   show, hide         the focused client asks for an input panel to be
+ *                      shown or hidden (text-input-v3 version 2)
+ *   press              a pointer button or touch went down on the
+ *                      keyboard-focused surface
+ *   release MS PX      that press ended, MS milliseconds after it began
+ *                      and PX layout pixels from where it began
+ *   key                a key of the typing block was pressed on a physical
+ *                      keyboard (not a virtual one, not a button such as
+ *                      volume or power)
+ *   keyboards N        N physical keyboards with letter keys are present
+ *
+ * With a listener set, clients learn of keyboard focus through text-input
+ * even when no input-method is bound, so that they report their fields.
+ */
+bool osk_reporting(void);
+
+void osk_report_field(struct seat *seat);
+void osk_report_panel(struct text_input *text_input, bool show);
+void osk_report_press(struct seat *seat, struct wlr_surface *surface,
+	double lx, double ly, uint32_t time_msec);
+void osk_report_release(double lx, double ly, uint32_t time_msec);
+void osk_report_key(uint32_t keycode, bool is_virtual);
+void osk_report_keyboards(struct seat *seat);
+
+#endif /* LABWC_OSK_H */
