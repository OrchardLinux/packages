diff --git a/src/input/osk.c b/src/input/osk.c
new file mode 100644
index 0000000..93f54b2
--- /dev/null
+++ b/src/input/osk.c
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "input/osk.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/input-event-codes.h>
+#include <math.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <wlr/config.h>
+#if WLR_HAS_LIBINPUT_BACKEND
+#include <wlr/backend/libinput.h>
+#endif
+#include <wlr/types/wlr_seat.h>
+#include <wlr/types/wlr_text_input_v3.h>
+#include <wlr/util/log.h>
+#include "common/spawn.h"
+#include "config/rcxml.h"
+#include "input/ime.h"
+#include "input/input.h"
+#include "input/keyboard.h"
+#include "labwc.h"
+
+static int listener_fd = -1;
+static uint32_t field_version; /* reported: 0 off, else the version */
+
+/* The reported press, until its release. */
+static struct {
+	bool down;
+	double lx, ly;
+	uint32_t time_msec;
+} press;
+
+bool
+osk_reporting(void)
+{
+	return rc.osk_listener && *rc.osk_listener;
+}
+
+/*
+ * One line to the listener, started on first use and again after it went
+ * away. The pipe does not block: a listener that stops reading loses
+ * lines, the compositor never waits for it.
+ */
+static void
+report(const char *format, ...)
+{
+	if (!osk_reporting()) {
+		return;
+	}
+	char line[64];
+	va_list args;
+	va_start(args, format);
+	int length = vsnprintf(line, sizeof(line) - 1, format, args);
+	va_end(args);
+	if (length < 0 || length >= (int)sizeof(line) - 1) {
+		return;
+	}
+	line[length++] = '\n';
+
+	for (int attempt = 0; attempt < 2; attempt++) {
+		if (listener_fd < 0) {
+			if (spawn_piped_async_no_shell(rc.osk_listener, &listener_fd) <= 0) {
+				listener_fd = -1;
+				return;
+			}
+			fcntl(listener_fd, F_SETFL, fcntl(listener_fd, F_GETFL) | O_NONBLOCK);
+			fcntl(listener_fd, F_SETFD, FD_CLOEXEC);
+		}
+		if (write(listener_fd, line, length) == length) {
+			return;
+		}
+		if (errno == EAGAIN) {
+			wlr_log(WLR_ERROR, "on-screen keyboard listener is not reading");
+			return;
+		}
+		close(listener_fd);
+		listener_fd = -1;
+	}
+}
+
+static struct text_input *
+focused_enabled_text_input(struct input_method_relay *relay)
+{
+	struct text_input *text_input;
+	wl_list_for_each(text_input, &relay->text_inputs, link) {
+		if (text_input->input->focused_surface
+				&& text_input->input->current_enabled) {
+			return text_input;
+		}
+	}
+	return NULL;
+}
+
+void
+osk_report_field(struct seat *seat)
+{
+	struct text_input *text_input =
+		focused_enabled_text_input(seat->input_method_relay);
+	uint32_t version = text_input
+		? (uint32_t)wl_resource_get_version(text_input->input->resource) : 0;
+	if (version == field_version) {
+		return;
+	}
+	field_version = version;
+	if (version) {
+		report("field on %u", version);
+	} else {
+		report("field off");
+	}
+}
+
+void
+osk_report_panel(struct text_input *text_input, bool show)
+{
+	if (text_input->input->focused_surface) {
+		report(show ? "show" : "hide");
+	}
+}
+
+void
+osk_report_press(struct seat *seat, struct wlr_surface *surface,
+		double lx, double ly, uint32_t time_msec)
+{
+	if (!surface || surface != seat->input_method_relay->focused_surface) {
+		return;
+	}
+	press.down = true;
+	press.lx = lx;
+	press.ly = ly;
+	press.time_msec = time_msec;
+	report("press");
+}
+
+void
+osk_report_release(double lx, double ly, uint32_t time_msec)
+{
+	if (!press.down) {
+		return;
+	}
+	press.down = false;
+	report("release %u %.0f", time_msec - press.time_msec,
+		hypot(lx - press.lx, ly - press.ly));
+}
+
+void
+osk_report_key(uint32_t keycode, bool is_virtual)
+{
+	/* Escape to F12: letters, digits, punctuation, modifiers, keypad. */
+	if (!is_virtual && keycode >= KEY_ESC && keycode <= KEY_F12) {
+		report("key");
+	}
+}
+
+/* A keyboard to type on: the device has letter keys (not gpio-keys). */
+static bool
+is_typing_keyboard(struct input *input)
+{
+	if (input->wlr_input_device->type != WLR_INPUT_DEVICE_KEYBOARD
+			|| ((struct keyboard *)input)->is_virtual) {
+		return false;
+	}
+#if WLR_HAS_LIBINPUT_BACKEND
+	if (wlr_input_device_is_libinput(input->wlr_input_device)) {
+		struct libinput_device *device =
+			wlr_libinput_get_device_handle(input->wlr_input_device);
+		return libinput_device_keyboard_has_key(device, KEY_A) > 0;
+	}
+#endif
+	return false;
+}
+
+void
+osk_report_keyboards(struct seat *seat)
+{
+	int count = 0;
+	struct input *input;
+	wl_list_for_each(input, &seat->inputs, link) {
+		count += is_typing_keyboard(input);
+	}
+	report("keyboards %d", count);
+}
