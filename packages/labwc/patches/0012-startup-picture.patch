+/*
+ * <core><startupPicture>FILE</startupPicture></core>: at boot no compositor
+ * came before, and the panel still shows the boot loader's splash. FILE is
+ * that splash (OSPL, width and height as little-endian u32, then the pixels
+ * as b, g, r, x, top row first); it is drawn as the boot loader drew it,
+ * centred on black on the panel's native mode, in place of the black cover,
+ * so the splash stays until the shell has drawn.
+ */
+static struct wlr_buffer *
+startup_picture_load(struct output *output)
+{
+	struct wlr_output_mode *mode = wlr_output_preferred_mode(output->wlr_output);
+	if (!rc.startup_picture || !mode || mode->width <= 0 || mode->height <= 0
+			|| mode->width > 16384 || mode->height > 16384) {
+		return NULL;
+	}
+	int fd = open(rc.startup_picture, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) {
+		return NULL;
+	}
+	struct wlr_buffer *buffer = NULL;
+	uint32_t *pixels = NULL, *row = NULL;
+	char magic[4];
+	uint32_t size[2];
+	struct stat st;
+	if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode)
+			|| !read_all(fd, magic, sizeof(magic)) || !read_all(fd, size, sizeof(size))
+			|| memcmp(magic, STARTUP_PICTURE_MAGIC, sizeof(magic))
+			|| !size[0] || !size[1]
+			|| size[0] > (uint32_t)mode->width || size[1] > (uint32_t)mode->height
+			|| (size_t)st.st_size != 12 + (size_t)size[0] * size[1] * 4) {
+		goto out;
+	}
+	size_t width = mode->width, height = mode->height;
+	pixels = malloc(width * height * 4);
+	row = malloc((size_t)size[0] * 4);
+	if (!pixels || !row) {
+		goto out;
+	}
+	for (size_t i = 0; i < width * height; i++) {
+		pixels[i] = 0xff000000;
+	}
+	size_t left = (width - size[0]) / 2, top = (height - size[1]) / 2;
+	for (size_t y = 0; y < size[1]; y++) {
+		if (!read_all(fd, row, (size_t)size[0] * 4)) {
+			goto out;
+		}
+		uint32_t *line = pixels + (top + y) * width + left;
+		for (size_t x = 0; x < size[0]; x++) {
+			line[x] = row[x] | 0xff000000;
+		}
+	}
+	buffer = &buffer_create_from_data(pixels, width, height, width * 4)->base;
+	pixels = NULL; /* the buffer's now */
+out:
+	free(row);
+	free(pixels);
+	close(fd);
+	return buffer;
+}
