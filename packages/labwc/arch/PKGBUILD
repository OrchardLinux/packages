# Orchard: Labwc with the tablet patches in ../patches (touch input fixes, the
# bottom-edge swipe, session transitions (and the boot splash held until the
# shell has drawn), the overview, facts for the
# on-screen keyboard), in the place of
# Arch's labwc. The name is Arch's and [orchard] is listed first, so
# `pacman -S labwc` and `pacman -Syu` take this one; the epoch puts it above
# whatever Arch build a tablet already has.
#
# Based on Arch's recipe (Maintainer: Peter Jung <ptr1337@archlinux.org>,
# Contributor: Lex Black <autumn-wind@web.de>): the same files and
# dependencies. The compositor itself is built as omarchy-a built it
# (release, pinned commit, patches applied without fuzz) and, also as there,
# has no cap_sys_nice file capability: the tablets' desktop has only been
# tested without it, and a program with file capabilities runs in secure
# mode, where the Vulkan loader ignores the environment that selects the GPU
# driver.

pkgname=labwc
_commit=97f28877a343e062f3178d201f0248cd9c2610cf
epoch=1
pkgver=0.20.2
pkgrel=11
pkgdesc='stacking wayland compositor with look and feel from openbox, with OrchardLinux tablet patches'
url="https://github.com/labwc/labwc"
arch=('aarch64' 'armv7h')
license=('GPL-2.0-only')
options=('!lto' '!debug')
depends=(
  cairo
  glib2
  glibc
  libinput
  libpng
  librsvg
  libsfdo
  libwlroots-0.20.so
  'wlroots0.20>=1:0.20.2-2'  # text-input-v3 version 2 (0007)
  libxcb
  libxkbcommon
  libxml2
  pango
  pixman
  seatd
  ttf-font
  wayland
)
checkdepends=(python)
makedepends=(
  gettext
  meson
  scdoc
  wayland-protocols
  xcb-util-wm
  xorg-xwayland
)
optdepends=(
  "bemenu: default launcher via Alt+F3"
  "xorg-xwayland: X11 application support"
)
_patches=(
  0001-cancel-super-tap-on-pointer.patch
  0002-bottom-edge-swipe.patch
  0003-session-transitions.patch
  0004-overview.patch
  0005-title-double-tap.patch
  0006-hide-cursor-until-pointer-input.patch
  0007-on-screen-keyboard-listener.patch
  0008-no-pointer-focus-while-cursor-hidden.patch
  0009-bottom-swipe-ignore-namespace-list.patch
  0010-overview-card-menu.patch
  0011-locked-key-release.patch
  0012-startup-picture.patch
  0013-bottom-swipe-overview.patch
)
source=("labwc-${_commit}.tar.gz::https://codeload.github.com/labwc/labwc/tar.gz/${_commit}"
        "${_patches[@]}")
sha256sums=('022676dbcbf6b6206b97d7bac8a339c8a0203e3e99693107c15b5a6183e4b0ea'
            '79b1d2a23a5ec2ffa7b5e479bf29af10f72f5f960e019e62d998a73cc25a2264'
            '6ad9344f373526841560b235c32bc157a3af550890f125a3e6f9deb00ed9202e'
            'b17d682b73b890cadde34cdede0529b361e4303c9e1d17ffc85ad7ae212884f8'
            '0af471fa5fdb9a8fbf5824a0ab4a28c44f3a2e740104e8079df0e8355b083c75'
            '0966d5b303c6230eb429154f0e24708cc3a5421cc7f02a8f81239e660456da67'
            'a32f6ba1f6254704c42c80098fb74e648d53271a27364014f6928067722e775b'
            'c767678e286a44bc35c18536f2ed7e9fe4d7d0c812dfe024aa30c0d524112283'
            'd0bf697fb73e3cc6e3b3e90448b5bc03903e129477d68f691f0dec1542acfc68'
            'cfaf13b54c712df2a41dc18d3b9a4358afeecb2384673b2ec44167a7186e9943'
            'f7e017810aa37f54c7db0f18bb92486ba1b7d40892377989d58d96e70c00b9c0'
            '9fa24e24cd27558826344fa4a0b091b8def183d9d4e6975062a9b73d97487a0a'
            '25320a75f762fafe91dc441198e61b34cc28e247438b9b68f90dffaf93ba4528'
            '11e55cda16bc28895747e4a9651135bb8caff08cb3c65f20448f78a45cad3ede')

prepare() {
  local patch
  for patch in "${_patches[@]}"; do
    patch --batch --fuzz=0 -d "labwc-${_commit}" -p1 -i "${srcdir}/${patch}"
  done
}

build() {
  # Not arch-meson: the compositor is built as a release, as the tablets have
  # run it. Man pages, labnag and the session unit only add Arch's files.
  meson setup "labwc-${_commit}" build --prefix=/usr --buildtype=release --wrap-mode=nofallback \
    -Dman-pages=enabled -Dlabnag=enabled -Dxwayland=enabled -Dnls=enabled -Dsystemd-session=enabled
  meson compile -C build
}

check() {
  # The patches' tests (../tests), on the patched source: the bottom swipe's
  # and the overview's arithmetic, and which touch configuration a named
  # device's swipe comes from (compiled against wlroots).
  local test
  for test in test-bottom-swipe test-overview; do
    cc -Wall -Werror -I"labwc-${_commit}/include" -o "${test}" "${startdir}/${test}.c" -lm
    "./${test}"
  done
  python3 "${startdir}/test-touch-config.py" "labwc-${_commit}"
  # Unit coverage of the cursor option, initial state and device detection;
  # DRM direct scanout and virtual-pointer delivery need an integration flight.
  python3 "${startdir}/test-hide-cursor.py" "labwc-${_commit}"
  # A hidden cursor gives no pointer focus (0008).
  python3 "${startdir}/test-touch-pointer-focus.py" "labwc-${_commit}"
  # The bottom swipe's ignore list (0009).
  python3 "${startdir}/test-swipe-ignore-list.py" "labwc-${_commit}"
  # A card's menu in the overview (0010).
  python3 "${startdir}/test-overview-menu.py" "labwc-${_commit}"
  # A key pressed on the lock screen gets its release too (0011).
  python3 "${startdir}/test-locked-key-release.py" "labwc-${_commit}"
  # The boot splash stays until the shell has drawn, over the lock (0012).
  python3 "${startdir}/test-startup-picture.py" "labwc-${_commit}"
  # The bottom swipe opens the overview with the finger, the launcher beyond (0013).
  python3 "${startdir}/test-bottom-swipe-overview.py" "labwc-${_commit}"
}

package() {
  meson install -C build --destdir "${pkgdir}"
  "${pkgdir}/usr/bin/labwc" --version | grep -q "${pkgver}"
  install -Dm 644 "labwc-${_commit}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  # The changes to upstream's source, beside its license.
  install -Dm 644 -t "${pkgdir}/usr/share/licenses/${pkgname}/patches" "${_patches[@]/#/${srcdir}/}"
}
