# Omactivity, the touch-first task manager, from its repository's main branch.
# The recipe is that repository's (pkgbuild/PKGBUILD), building the pinned
# commit's archive instead of a checkout. tools/pkgrepo bump writes _commit,
# pkgver, pkgrel and the archive's checksum when the repository moves (see
# ../source.json).

pkgname=omactivity
_commit=abf09012089eb7f8e78740aa7f706efbb97732af
pkgver=0.1.1
pkgrel=1
pkgdesc="Touch-first task manager for Omarchy"
arch=('aarch64' 'armv7h')
url='https://github.com/OrchardLinux/omactivity'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'wayland')
checkdepends=('ttf-dejavu')
optdepends=('sudo: quit and reprioritize processes of root and other users')
backup=('etc/omactivity/protected.conf')
source=("omactivity-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=('3a457e7d1ed5e0b6b5305324f4119f0df6bbda67acd80a3de813c26f7d584bb5')

build() {
    mkdir -p build
    cd build
    qmake6 "../omactivity-${_commit}/omactivity.pro"
    make
}

check() {
    # The tests are Qt Quick tests; the build has no display.
    QT_QPA_PLATFORM=offscreen OMACTIVITY_TEST_BUILD="${srcdir}/tests" sh "omactivity-${_commit}/bin/test"
}

package() {
    make -C build INSTALL_ROOT="${pkgdir}" install
    install -Dm644 "omactivity-${_commit}/LICENSE" "${pkgdir}/usr/share/licenses/omactivity/LICENSE"
}
