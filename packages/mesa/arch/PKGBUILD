# Mesa from OrchardLinux's fork, in the place of Arch's mesa package on every
# 64-bit board. Two builds of one source:
#
# - the Vulkan driver for the Apple PowerVR GPUs orchard's powervr kernel
#   driver runs (the A10's and the A9's), built as it was before this package
#   took over OpenGL;
# - OpenGL, GLES, EGL, GBM and GLX with the drivers the tablets use: Zink (the
#   GPU desktop, on the Vulkan driver above) and llvmpipe and softpipe
#   (software OpenGL, on every board and wherever the GPU is not used), built
#   as a release like Arch's.
#
# Zink comes from the fork so that its changes for the A9 reach the tablet;
# they act only on a device whose Vulkan driver names itself the A9's, and
# one of them is a default in this package's 00-mesa-defaults.conf (S3TC
# textures transcoded to ETC2). Arch's drivers for other hardware and its
# VA-API drivers are left out: no board has that hardware.
#
# With it gpu-probe, a login session's test that this stack draws on the
# board it runs on. The kernel side is orchard's.
#
# The name is Arch's, so that `pacman -S mesa` and `pacman -Syu` take this
# package from [orchard], which is listed first. The epoch is Arch's too: what
# depends on a mesa version, and a tablet that still has Arch's mesa, both
# compare against 1:. tools/pkgrepo bump writes _commit, pkgver, pkgrel and the
# archive's checksum when OrchardLinux/mesa moves (see ../source.json).

pkgname=mesa
_commit=60645432fe8944a1c8e249ea9a5f0fb12edc48d5
epoch=1
# Mesa's version, the commit's number on the fork's main branch (so that a
# newer commit is a newer package), and the commit.
pkgver=27.0.0.3
pkgrel=1
pkgdesc="Mesa from the OrchardLinux fork: OpenGL through Zink or in software, the Vulkan driver for the Apple PowerVR GPUs, and the desktop's GPU probe"
url="https://github.com/OrchardLinux/mesa"
license=('MIT')
arch=('aarch64')
options=('!lto' '!debug')
# libLLVM.so: llvmpipe runs on the LLVM this was built with; makepkg records its version.
depends=('expat' 'gcc-libs' 'glibc' 'libdisplay-info' 'libdrm' 'libglvnd' 'libLLVM.so' 'libx11' 'libxcb'
         'libxext' 'libxshmfence' 'libxxf86vm' 'spirv-tools' 'systemd-libs' 'vulkan-icd-loader' 'wayland' 'zlib'
         'zstd')
# Clang and libclc compile the Vulkan driver's internal shaders at build time only.
makedepends=('bison' 'clang' 'flex' 'glslang' 'libclc' 'libxfixes' 'libxkbcommon' 'libxrandr' 'llvm' 'meson' 'ninja'
             'pkgconf' 'python-mako' 'python-packaging' 'python-ply' 'python-yaml' 'spirv-llvm-translator'
             'vulkan-headers' 'wayland-protocols' 'xorgproto')
# mesa-orchard: this package's name while omarchy-a built it.
provides=("mesa-libgl=${epoch}:${pkgver}-${pkgrel}" 'opengl-driver' 'vulkan-driver'
          "mesa-orchard=${pkgver}-${pkgrel}" "vulkan-powervr-orchard=${pkgver}-${pkgrel}")
conflicts=('mesa-libgl' 'mesa-orchard' 'vulkan-powervr' 'vulkan-powervr-orchard')
replaces=('mesa-orchard' 'vulkan-powervr-orchard')
source=("mesa-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz" gpu-probe.c)
sha256sums=('afd7ffe55150083635b538865f9ceab4ae068ec638a36b046ce4486e72b4b246'
            '8b6622bdd9bba6f8bdcc7bf407e98078517e8823a7ce22416774ca88481864f2')

build() {
	# Not arch-meson: its --auto-features=enabled turns on Mesa features this
	# package leaves out.
	local common=(--prefix=/usr --wrap-mode=nodownload -Db_lto=false -Dllvm=enabled -Dgles1=disabled
		-Dvideo-codecs= -Dtools= -Dvulkan-layers= -Dbuild-tests=false)
	# The Vulkan driver, with the options it has been tested with on the tablets.
	meson setup "mesa-${_commit}" build-vulkan "${common[@]}" --buildtype=debugoptimized \
		-Dplatforms=x11,wayland -Dvulkan-drivers=imagination -Dgallium-drivers= \
		-Dopengl=false -Degl=disabled -Dgbm=disabled -Dglx=disabled -Dgles2=disabled
	ninja -C build-vulkan
	# OpenGL. X11 and GLX are for applications under Xwayland, as in Arch's mesa.
	meson setup "mesa-${_commit}" build-gl "${common[@]}" --buildtype=release -Db_ndebug=true \
		-Dplatforms=x11,wayland -Dvulkan-drivers= -Dgallium-drivers=zink,llvmpipe,softpipe \
		-Dopengl=true -Dgles2=enabled -Degl=enabled -Dgbm=enabled -Dglx=dri -Dglvnd=enabled \
		-Dshared-llvm=enabled -Dgallium-va=disabled -Dgallium-rusticl=false -Dgallium-extra-hud=false \
		-Dlmsensors=disabled -Dvalgrind=disabled -Dlibunwind=disabled -Dteflon=false
	ninja -C build-gl
	# This package's GBM, and the system's libglvnd and libdrm in front of it:
	# what the desktop draws through.
	cc ${CFLAGS} -Wall -Wextra -I"mesa-${_commit}/src/gbm/main" gpu-probe.c -o gpu-probe ${LDFLAGS} \
		-Lbuild-gl/src/gbm -lgbm $(pkg-config --cflags --libs egl glesv2 libdrm)
}

package() {
	DESTDIR="${pkgdir}" meson install -C build-gl --no-rebuild
	# The drivers that make this package what the image needs.
	local gallium=("${pkgdir}"/usr/lib/libgallium-*.so)
	[[ ${#gallium[@]} == 1 ]]
	for driver in zink llvmpipe softpipe; do grep -q "${driver}" "${gallium[0]}"; done
	for file in lib/libEGL_mesa.so.0 lib/libGLX_mesa.so.0 lib/libgbm.so.1 lib/gbm/dri_gbm.so lib/dri/zink_dri.so \
		lib/dri/swrast_dri.so lib/dri/kms_swrast_dri.so share/glvnd/egl_vendor.d/50_mesa.json; do
		[[ -e ${pkgdir}/usr/${file} ]]
	done
	# The A9's Zink default, S3TC textures transcoded to ETC2, is in this file.
	grep -A 3 '<device driver="zink" device="g5p">' "${pkgdir}/usr/share/drirc.d/00-mesa-defaults.conf" |
		grep -q '<option name="transcode_s3tc" value="1" />'

	install -Dm 755 build-vulkan/src/imagination/vulkan/libvulkan_powervr_mesa.so \
		"${pkgdir}/usr/lib/libvulkan_powervr_mesa.so"
	# The build tree's manifest names the library by its build path.
	sed 's#"library_path": "[^"]*"#"library_path": "/usr/lib/libvulkan_powervr_mesa.so"#' \
		build-vulkan/src/imagination/vulkan/powervr_mesa_icd.*.json > powervr_mesa_icd.json
	grep -q '"library_path": "/usr/lib/libvulkan_powervr_mesa.so"' powervr_mesa_icd.json
	install -Dm 644 powervr_mesa_icd.json "${pkgdir}/usr/share/vulkan/icd.d/powervr_mesa_icd.json"
	install -Dm 755 gpu-probe "${pkgdir}/usr/lib/orchard/gpu-probe"
	# Where omarchy-a's login session looks for it.
	install -d "${pkgdir}/usr/lib/omarchy-a"
	ln -s ../orchard/gpu-probe "${pkgdir}/usr/lib/omarchy-a/gpu-probe"
	install -Dm 644 "mesa-${_commit}/docs/license.rst" "${pkgdir}/usr/share/licenses/${pkgname}/license.rst"
}
