# Maintainer: Robin Candau <antiz@archlinux.org>
# Orchard: Arch's wlroots0.20 with fast rotated pixman compositing, a GLES2
# renderer that samples shared-memory buffers in place, and text-input-v3
# version 2 (apps asking for the on-screen keyboard), until wlroots has them
# (see ../patches). The name is Arch's and [orchard] is listed first,
# so pacman takes this one; the epoch puts it above whatever Arch build a
# tablet already has.

pkgname=wlroots0.20
_pkgname=wlroots
epoch=1
pkgver=0.20.2
pkgrel=2
pkgdesc="Modular Wayland compositor library"
url="https://gitlab.freedesktop.org/wlroots/wlroots"
license=('MIT')
arch=('aarch64' 'armv7h')
depends=('glibc' 'libdisplay-info.so' 'libdrm' 'libglvnd' 'libinput' 'liblcms2.so' 'libliftoff.so' 'libpixman-1.so'
         'libseat.so' 'libudev.so' 'libvulkan.so' 'libwayland-client.so' 'libwayland-server.so' 'libxcb' 'libxkbcommon.so'
         'wayland-protocols' 'opengl-driver' 'xcb-util-errors' 'xcb-util-renderutil' 'xcb-util-wm')
makedepends=('glslang' 'meson' 'ninja' 'systemd' 'vulkan-headers' 'xorg-xwayland')
optdepends=('xorg-xwayland: Xwayland support'
            'vulkan-validation-layers: validation layers for the experimental vulkan renderer backend')
provides=("libwlroots-${pkgver%.*}.so")
source=("${_pkgname}-${pkgver}.tar.gz::${url}/-/releases/${pkgver}/downloads/${_pkgname}-${pkgver}.tar.gz"
        '0001-render-pixman-rotate-first-then-blend-for-90-degree.patch'
        '0002-render-gles2-sample-shared-memory-client-buffers-in-place.patch'
        '0003-text-input-v3-support-version-2.patch')
sha256sums=('80c567d2ed4efb2cfa6b077f22c7a710d9c78ba4e185a75e8694001114af0733'
            '234879eb7b870b361bab5197409ef30201a09d9f5ab6c3b5715fde9f5ff796b8'
            'f1301387337c41e6b2910e2c839d4120888aed883bcdf7ccdd0421699c328529'
            'd814b1eebe52237c032b0355295cfb42282036520b24450b1b147d66bd84521d')

prepare() {
	patch -d "${_pkgname}-${pkgver}" -p1 < 0001-render-pixman-rotate-first-then-blend-for-90-degree.patch
	patch -d "${_pkgname}-${pkgver}" -p1 < 0002-render-gles2-sample-shared-memory-client-buffers-in-place.patch
	patch -d "${_pkgname}-${pkgver}" -p1 < 0003-text-input-v3-support-version-2.patch
}

build() {
	arch-meson "${_pkgname}-${pkgver}" build
	ninja -C build
}

package() {
	DESTDIR="${pkgdir}" ninja -C build install
	install -Dm 644 "${_pkgname}-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
