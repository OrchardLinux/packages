# orchard's kernel for apple-4k: an orchard release's platform layer, unchanged
# (kernel, modules, the boards' device trees, orchard's initrd, hardware defaults
# and /usr/lib/orchard/boot-entries), with the apk scripts and trigger that run
# boot-entries. Plain abuild builds it. A release of orchard is a new pkgver and
# checksum (`tools/pkgrepo orchard-release VERSION` writes both).
pkgname=linux-orchard-apple-4k
_platform=apple-4k
pkgver=0.3.8
pkgrel=0
pkgdesc="orchard's Linux kernel, modules, device trees and initrd for Apple A7, A8 and A8X"
url="https://github.com/OrchardLinux/orchard"
arch="aarch64"
license="GPL-2.0-only AND ISC"
# One platform per system: the platforms' packages share the hardware defaults.
depends="!linux-orchard-apple-16k"
# It carries the regulatory database.
replaces="wireless-regdb"
options="!check !strip !tracedeps"
install="$pkgname.pre-upgrade $pkgname.pre-deinstall"
triggers="$pkgname.trigger=/usr/lib/modules/*:/usr/share/orchard:/usr/lib/orchard"
source="platform-$_platform-$pkgver.tar.gz::$url/releases/download/v$pkgver/platform-$_platform.tar.gz"
builddir="$srcdir"

package() {
	# abuild unpacked the layer into $srcdir: its usr/ is the package.
	mkdir -p "$pkgdir"
	cp -a "$srcdir"/usr "$pkgdir"/
}

sha512sums="
b067d22d91d445a059d2fa050e4e37880b55523f5cc05f04b67e0c9906e587550508db19bedb850b17c5ad02681196d3b6511945f66b720a484bb0892c3c2a06  platform-$_platform-$pkgver.tar.gz
"
