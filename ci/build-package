#!/usr/bin/env bash
# Build one package for one architecture into out/. Needs Docker on an arm64
# host; with CCACHE=1 the compiler cache is kept in .ccache/.
#
#   ci/build-package PACKAGE ARCH VERSION
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repo=$(dirname "$here")
package=$1 arch=$2 version=$3
mkdir -p "$repo/out"
mounts=(-v "$repo:/repo:ro" -v "$repo/out:/out")
if [[ ${CCACHE:-} == 1 ]]; then
  mkdir -p "$repo/.ccache"
  mounts+=(-v "$repo/.ccache:/ccache")
fi
"$here/container" "$arch" "${mounts[@]}" -- bash /repo/ci/container-build "$package" "$version"
