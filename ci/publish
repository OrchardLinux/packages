#!/usr/bin/env bash
# Add built packages to the published repositories: pacman's `orchard`, the
# files of the GitHub release repo-ARCH, and the apk repository, the files of
# the release named ARCH (apk asks SERVER/ARCH/APKINDEX.tar.gz). The only place
# that writes the indexes; the workflow runs one publish at a time.
#
#   ci/publish ARTIFACTS    ARTIFACTS/package-arch-ARCH-NAME/NAME-VERSION-ARCH.pkg.tar.zst
#                           ARTIFACTS/package-alpine-ARCH-NAME/NAME-VERSION.apk
#
# Packages go up first and the index last, and the files of the index before
# this one stay: a tablet that read the old index still finds its packages.
#
# Signing: when ORCHARD_SIGNING_KEY holds the armored secret signing subkey
# (docs/signing.md), every pacman package and the index are signed with it;
# without it that repository is unsigned. apk indexes are always signed, with
# ORCHARD_APK_KEY when it is set and else with a key made for this publish,
# which no user has (--allow-untrusted until the key exists).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repo=$(dirname "$here")
artifacts=$(cd "$1" && pwd)
: "${GH_REPO:=${GITHUB_REPOSITORY:?}}"
export GH_REPO

for arch in aarch64 armv7h; do
  shopt -s nullglob
  packages=("$artifacts"/package-arch-"$arch"-*/*.pkg.tar.zst)
  shopt -u nullglob
  tag=repo-$arch
  # Packages whose recipe is gone leave the index (tools/pkgrepo dropped).
  drop=()
  if gh release view "$tag" >/dev/null 2>&1; then
    probe=$(mktemp -d)
    gh release download "$tag" --pattern orchard.db --dir "$probe" 2>/dev/null || true
    mapfile -t drop < <(python3 "$repo/tools/pkgrepo" dropped --base arch "$probe/orchard.db")
    rm -rf "$probe"
  fi
  (( ${#packages[@]} + ${#drop[@]} )) || continue
  if ! gh release view "$tag" >/dev/null 2>&1; then
    gh release create "$tag" --latest=false --title "Package repository: $arch" --notes \
"The pacman repository \`orchard\` for $arch. Not a release to download by hand: pacman reads it.

    [orchard]
    Server = https://github.com/$GH_REPO/releases/download/repo-\$arch

See the README for the whole pacman.conf entry."
  fi
  work=$(mktemp -d)
  mkdir "$work/old" "$work/new"
  for file in orchard.db orchard.files built.json; do
    gh release download "$tag" --pattern "$file" --dir "$work/old" 2>/dev/null || true
  done
  [[ ! -f $work/old/orchard.db ]] || cp "$work/old/orchard.db" "$work/new/orchard.db.tar.gz"
  [[ ! -f $work/old/orchard.files ]] || cp "$work/old/orchard.files" "$work/new/orchard.files.tar.gz"
  [[ ! -f $work/old/built.json ]] || cp "$work/old/built.json" "$work/new/built.json"
  (( ! ${#packages[@]} )) || cp "${packages[@]}" "$work/new/"
  # The artifact's directory names the package (ci/container-build checked it).
  names=()
  for package in "${packages[@]}"; do
    directory=$(basename "$(dirname "$package")")
    names+=("${directory#package-arch-"$arch"-}")
  done
  printf '%s\n' "${drop[@]}" > "$work/new/.drop"

  sign=()
  if [[ -n ${ORCHARD_SIGNING_KEY:-} ]]; then
    printf '%s\n' "$ORCHARD_SIGNING_KEY" > "$work/new/.signing-key"
    sign=(--sign)
  fi
  # repo-add is pacman's; any architecture's container has it.
  "$here/container" aarch64 -v "$work/new:/work" -w /work -- bash -euc '
    shopt -s nullglob
    packages=(*.pkg.tar.zst)
    if [[ -f .signing-key ]]; then
      export GNUPGHOME=$(mktemp -d)
      gpg --batch --import .signing-key
      rm .signing-key
      for package in "${packages[@]}"; do gpg --batch --yes --detach-sign --no-armor "$package"; done
    fi
    mapfile -t drop < <(grep . .drop || true)
    rm .drop
    (( ! ${#drop[@]} )) || repo-remove "$@" orchard.db.tar.gz "${drop[@]}"
    (( ! ${#packages[@]} )) || repo-add "$@" orchard.db.tar.gz "${packages[@]}"
  ' repo-add "${sign[@]}"
  sudo chown -R "$(id -u):$(id -g)" "$work/new"
  python3 "$repo/tools/pkgrepo" record --base arch "$work/new/built.json" "${names[@]}"

  shopt -s nullglob
  uploads=("$work"/new/*.pkg.tar.zst "$work"/new/*.pkg.tar.zst.sig)
  (( ! ${#uploads[@]} )) || gh release upload "$tag" --clobber "${uploads[@]}"
  # The index under the names pacman asks for.
  mkdir "$work/index"
  cp "$work/new/orchard.db.tar.gz" "$work/index/orchard.db"
  cp "$work/new/orchard.files.tar.gz" "$work/index/orchard.files"
  for name in orchard.db orchard.files; do
    [[ ! -f $work/new/$name.tar.gz.sig ]] || cp "$work/new/$name.tar.gz.sig" "$work/index/$name.sig"
  done
  cp "$work/new/built.json" "$work/index/"
  gh release upload "$tag" --clobber "$work"/index/*
  shopt -u nullglob

  mapfile -t assets < <(gh release view "$tag" --json assets --jq '.assets[].name')
  mapfile -t stale < <(python3 "$repo/tools/pkgrepo" prune --base arch \
    --index "$work/index/orchard.db" "$work/old/orchard.db" --assets "${assets[@]}")
  for asset in "${stale[@]}"; do
    gh release delete-asset "$tag" "$asset" --yes
  done
  echo "Published to $tag: ${names[*]}${drop[*]:+; removed: ${drop[*]}}"
  rm -rf "$work"
done

for arch in aarch64 armv7; do
  shopt -s nullglob
  packages=("$artifacts"/package-alpine-"$arch"-*/*.apk)
  shopt -u nullglob
  (( ${#packages[@]} )) || continue
  tag=$arch
  if ! gh release view "$tag" >/dev/null 2>&1; then
    gh release create "$tag" --latest=false --title "Package repository: Alpine $arch" --notes \
"The apk repository for Alpine on $arch. Not a release to download by hand: apk reads it.

    echo https://github.com/$GH_REPO/releases/download >> /etc/apk/repositories

See the README."
  fi
  work=$(mktemp -d)
  mkdir "$work/old" "$work/new"
  for file in APKINDEX.tar.gz built.json; do
    gh release download "$tag" --pattern "$file" --dir "$work/old" 2>/dev/null || true
  done
  [[ ! -f $work/old/built.json ]] || cp "$work/old/built.json" "$work/new/built.json"
  cp "${packages[@]}" "$work/new/"
  names=()
  for package in "${packages[@]}"; do
    directory=$(basename "$(dirname "$package")")
    names+=("${directory#package-alpine-"$arch"-}")
  done
  # apk index reads the packages themselves: the ones the old index keeps come back down.
  if [[ -f $work/old/APKINDEX.tar.gz ]]; then
    while read -r file; do
      name=${file%-*-r*.apk}
      [[ " ${names[*]} " == *" $name "* ]] || gh release download "$tag" --pattern "$file" --dir "$work/new"
    done < <(python3 "$repo/tools/pkgrepo" files --base alpine "$work/old/APKINDEX.tar.gz")
  fi
  [[ -z ${ORCHARD_APK_KEY:-} ]] || printf '%s\n' "$ORCHARD_APK_KEY" > "$work/new/.signing-key"
  "$here/container" alpine-aarch64 -v "$work/new:/work" -w /work -- sh -euc '
    apk add --no-cache abuild >/dev/null
    if [ -f .signing-key ]; then
      mkdir -p /keys && mv .signing-key /keys/orchard.rsa
    else
      mkdir -p /keys && openssl genrsa -out /keys/orchard.rsa 4096 2>/dev/null
    fi
    openssl rsa -in /keys/orchard.rsa -pubout -out /keys/orchard.rsa.pub 2>/dev/null
    apk index --allow-untrusted --description "Orchard packages" -o APKINDEX.tar.gz *.apk
    abuild-sign -k /keys/orchard.rsa -p orchard.rsa.pub APKINDEX.tar.gz
  '
  sudo chown -R "$(id -u):$(id -g)" "$work/new"
  python3 "$repo/tools/pkgrepo" record --base alpine "$work/new/built.json" "${names[@]}"
  gh release upload "$tag" --clobber "$work"/new/*.apk
  gh release upload "$tag" --clobber "$work/new/APKINDEX.tar.gz" "$work/new/built.json"
  mapfile -t assets < <(gh release view "$tag" --json assets --jq '.assets[].name')
  mapfile -t stale < <(python3 "$repo/tools/pkgrepo" prune --base alpine \
    --index "$work/new/APKINDEX.tar.gz" "$work/old/APKINDEX.tar.gz" --assets "${assets[@]}")
  for asset in "${stale[@]}"; do
    gh release delete-asset "$tag" "$asset" --yes
  done
  echo "Published to $tag: ${names[*]}"
  rm -rf "$work"
done
