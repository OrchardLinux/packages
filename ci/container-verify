#!/usr/bin/env bash
# Inside a fresh Arch Linux ARM container: what a tablet does. Arch's own
# labwc, wlroots0.20 and mesa are installed first; then [orchard] is listed
# before Arch's repositories and `pacman -Syu` has to replace them with ours.
# After that every package of the repository installs and pacman finds
# nothing wrong with the result.
set -euo pipefail
: "${ORCHARD_ARCH:?}" "${ORCHARD_SERVER_BASE:?}"
bash /repo/ci/prepare-pacman
replaced=(labwc wlroots0.20 mesa)
pacman-download -S --noconfirm --needed "${replaced[@]}"
pacman -S --noconfirm --needed "${replaced[@]}"

bash /repo/ci/tablet-repos /etc/pacman.conf "$ORCHARD_ARCH" "$ORCHARD_SERVER_BASE" --trust
pacman -Syu --noconfirm
mapfile -t all < <(pacman -Slq orchard)
(( ${#all[@]} ))
# orchard's kernel packages conflict with each other (linux-orchard): they are
# checked one at a time, after the rest.
ours=() kernels=()
for name in "${all[@]}"; do
  if [[ $name == linux-orchard-* ]]; then kernels+=("$name"); else ours+=("$name"); fi
done
for name in "${replaced[@]}"; do
  [[ " ${ours[*]} " != *" $name "* ]] || pacman -Sl orchard | grep "^orchard $name .*\[installed\]$" >/dev/null
done
pacman -S --noconfirm --needed "${ours[@]}"
pacman -Sl orchard
# Every package installed, at the repository's version.
[[ $(pacman -Sl orchard | grep -c '\[installed\]$') == "${#ours[@]}" ]]
# `pacman -S NAME` keeps taking ours.
[[ $(pacman -S --print --print-format '%r' "${ours[@]}" | sort -u) == orchard ]] ||
  { echo 'pacman took a package elsewhere' >&2; exit 1; }
pacman -Dk
pacman -Qk "${ours[@]}"
[[ " ${ours[*]} " != *" labwc "* ]] || { [[ $(pacman -Qoq /usr/bin/labwc) == labwc ]]; labwc --version; }
[[ " ${ours[*]} " != *" mesa "* ]] ||
  [[ $(pacman -Qoq /usr/lib/libEGL_mesa.so.0 /usr/lib/libgbm.so.1 /usr/lib/libvulkan_powervr_mesa.so /usr/lib/orchard/gpu-probe | sort -u) == mesa ]]
# A kernel package installs, and on a system the Orchard installer did not set up
# (no /etc/orchard/boot-entry) its hooks write and keep nothing.
pacman -Rdd --noconfirm wireless-regdb 2>/dev/null || true
for name in "${kernels[@]}"; do
  pacman -S --noconfirm "$name"
  pacman -Qk "$name"
  [[ $(pacman -Qoq /usr/share/libalpm/hooks/95-orchard-boot-entries.hook) == "$name" ]]
  # Layers from orchard 0.4 on carry the script; the hooks skip it where it is missing.
  [[ ! -x /usr/lib/orchard/boot-entries ]] || /usr/lib/orchard/boot-entries sync | grep -q 'nothing to do'
  [[ ! -e /boot/loader ]]
  pacman -R --noconfirm "$name"
  [[ ! -e /usr/lib/modules/.orchard-saved ]]
  if compgen -G '/usr/lib/modules/*/.orchard-kept' >/dev/null; then echo "$name kept a kernel" >&2; exit 1; fi
done
pacman -Dk
echo "Verified $ORCHARD_ARCH: ${all[*]}"
